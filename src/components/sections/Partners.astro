---
import type { BrandData } from "@/types/brand";

import { STORAGE_PATH } from "@/lib/consts";

interface Props {
  brandData: BrandData;
  full?: boolean;
}

const { brandData, full = false } = Astro.props;

// Объединяем все логотипы в один массив
const allPartnersLogos = [...brandData.partners.default_logos, ...(brandData.partners.additional_logos || [])];
---

<section class:list={[full ? "py-8 md:py-10 lg:py-20" : "py-10"]} data-cmp="Partners">
  <div class="container">
    {full && <h2 class="mb-8 md:12 lg:mb-16 typo-h3-x2 uppercase">Наши клиенты</h2>}

    <div
      class:list={[
        full
          ? "grid grid-cols-[repeat(auto-fill,minmax(120px,1fr))] lg:grid-cols-4 gap-4"
          : "flex flex-wrap justify-center gap-5 gap-y-10 lg:gap-20",
      ]}
    >
      {
        allPartnersLogos.map((logo: any) => (
          <div
            class:list={[
              "flex items-center justify-center",
              full
                ? "h-25 lg:h-50 w-full rounded-xl bg-white"
                : "shrink-0 max-h-8 lg:max-h-[75px] max-w-[156px]",
            ]}
          >
            <img
              class:list={["h-full w-full object-contain", full ? "max-w-[35%] max-h-[35%]" : ""]}
              src={`${STORAGE_PATH}${logo}`}
              alt={`Логотип партнера нашей компании`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
