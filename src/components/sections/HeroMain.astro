---
import Button from "@/components/ui/Button.astro";
import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";
import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: any;
}

const { brandData } = Astro.props;
const discount = getDiscountPercent(brandData.main.adv_price_percent);
const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);

const heroPrice =
  brandData.main?.adv_price && Number(brandData.main.adv_price) > 0 ? brandData.main.adv_price : showDiscount ? discountedPrice : price;
---

<section class="hero grid grid-cols-[100%] min-h-[700px] bg-hero-main-surface" data-cmp="HeroMain">
  <div class="container h-full">
    <div class="grid grid-cols-1 lg:grid-cols-[3fr_2.2fr] gap-3 items-center h-full py-3">
      <div class="flex flex-col gap-10 text-hero-main-text">
        <h1 class="flex flex-col items-start uppercase">
          <span class="typo-h2-x2">Персонал для любой работы </span>
          <span class="typo-h2-x2 bg-[#176ABD] rounded-2xl py-2 px-5 whitespace-nowrap">от {heroPrice}₽</span>
        </h1>

        <p class="max-w-120 my-auto">
          Упакуем, аккуратно перевезём и расставим мебель в новом помещении. Работаем быстро и без срывов сроков
        </p>

        <div class="mt-auto">
          <Button href="#kp" variant="accent" text="Получить КП" />
        </div>
      </div>

      <div class="flex items-center justify-center">
        <img src="/images/hero-main.webp" alt="" fetchpriority="high" class="pointer-events-none" />
      </div>
    </div>
  </div>
</section>

<section class="bg-[#176ABD]">
  <div class="container">
    <HeroFeatures {brandData} />
  </div>
</section>
