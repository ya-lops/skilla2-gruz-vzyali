---
import type { BrandData } from "@/types/brand";
import KpForm from "../blocks/KpForm.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section id="kp" class="scroll-mt-25 my-10 bg-kp-surface" data-cmp="KP">
  <div class="container">
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_1fr] items-center">
      <div class="">
        <h2 class="typo-h5-x2 uppercase text-kp-text">Бесплатно сделаем коммерческое предложение</h2>
        <div class="mt-20">
          <KpForm />
        </div>
      </div>
      <div class="flex justify-center items-end">
        <img src="/images/kp-image.webp" alt="" class="pointer-events-none" />
      </div>
    </div>
  </div>
</section>
