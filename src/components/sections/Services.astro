---
import type { BrandData } from "@/types/brand";

import { getDiscountedPrice, getDiscountPercent, hasDiscount } from "@/utils/price";

import Button from "@/components/ui/Button.astro";
import IconService from "@/components/IconService.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();

// Функция для поиска подуслуги с минимальной ценой
function getMinPriceService(subServices: Array<{ price: string; unit: string; name: string }>) {
  return subServices.reduce((min, current) => (parseFloat(current.price) < parseFloat(min.price) ? current : min));
}

// Получаем скидку по акции
const discount = getDiscountPercent(brandData.main.adv_price_percent);

const hasOrder = brandData.services.some((s) => s.order !== undefined);

const sortedServices = (
  hasOrder
    ? brandData.services.sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0))
    : brandData.services.map((service, index) => ({
        ...service,
        order: index < 3 ? index + 1 : null,
      }))
)
  .filter((service) => service.is_active === 1)
  .slice(0, 7);

function isFeatured(service: (typeof sortedServices)[0]): boolean {
  return (Number(service.order) || 0) > 0;
}
---

<section class="py-8 md:py-10 lg:py-20 overflow-clip" data-cmp="Services">
  <div class="container">
    <h2 class="mb-8 md:12 lg:mb-16 typo-h3-x2 uppercase">Наши услуги</h2>

    <div class="flex flex-col">
      {
        sortedServices.map((service, index) => {
          const minService = getMinPriceService(service.services);
          const discountedPrice = getDiscountedPrice(minService.price, discount);
          const isFeatured = index < 3;

          if (isFeatured) {
            return (
              <div class="grid grid-cols-1 md:grid-cols-[1fr_minmax(0,1fr)] gap-6 mb-6 bg-white rounded-2xl">
                <div class="flex flex-col gap-5 p-4 md:p-10 lg:p-15">
                  <h3 class="mb-6 typo-h5-x2">{service.name}</h3>
                  <p class="typo-t3 text-text-secondary text-balance">
                    {service.description ||
                      "С ежедневной оплатой для стройки, склада, погрузки и уборки. Доступные срочно и без посредников"}
                  </p>
                  <div class="mt-5">
                    <Button href={`/${service.url.toLowerCase()}`} variant="primary" text={`от ${discountedPrice} ₽`} />
                  </div>
                </div>

                <div
                  class={`flex w-[min(350px,100%)] justify-center m-3 bg-[#F2F4FA] aspect-square rounded-full justify-self-center ${index === 1 ? "self-start" : "self-end"}`}
                >
                  <img
                    src={`/images/service-${index + 1}.webp`}
                    alt={`Изображение для услуги ${service.name}`}
                    class={`h-full max-w-max pointer-events-none ${
                      index === 0 ? "translate-y-3 translate-x-[-10%]" : index === 1 ? "-translate-y-3" : "translate-y-3"
                    }`}
                    loading="lazy"
                  />
                </div>
              </div>
            );
          }

          return (
            <div class="grid grid-cols-1 md:grid-cols-[1fr_1.3fr_auto] gap-6 md:gap-20 py-10 not-last:border-b not-last:border-b-outline">
              <h3 class="typo-h5-x2">{service.name}</h3>
              <p class="typo-t3 text-text-secondary text-balance">
                {service.description || "С ежедневной оплатой для стройки, склада, погрузки и уборки. Доступные срочно и без посредников"}
              </p>
              <Button href={`/${service.url.toLowerCase()}`} variant="primary" text={`от ${discountedPrice} ₽`} />
            </div>
          );
        })
      }
    </div>
    <div class="flex items-center justify-center gap-4 mt-16">
      <Button href={firstServiceUrl} variant="secondary" text="Все услуги" arrow="right" />
    </div>
  </div>
</section>
