---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: any;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section class="relative z-2 hero grid grid-cols-[100%] min-h-[630px] my-4" data-cmp="HeroAbout">
  <div class="container h-full isolate">
    <div class="grid grid-cols-1 grid-rows-[1fr_auto] lg:grid-rows-1 lg:grid-cols-[1fr_437px] gap-6 h-full isolate">
      <div class="flex flex-col gap-6 p-4 max-lg:pb-40 lg:p-10 bg-hero-main-surface text-hero-main-text rounded-[20px] lg:rounded-[40px]">
        <h1 class="max-w-[50rem] typo-h1-x2 uppercase leading-[80%]">87 000<br>заказов за 10&nbsp;лет работы</h1>

        <div class="mt-auto">
          <Button href={`/${firstServiceUrl}`} variant="accent" text="Наши услуги" />
        </div>
      </div>

      <div class="z-1 max-lg:max-h-[200px] flex items-end justify-end rounded-[20px] lg:rounded-[40px] add-gradient">
        <img
          src="/images/hero-about.webp"
          alt=""
          fetchpriority="high"
          class="lg:max-w-max max-lg:max-h-[360px] pointer-events-none"
        />
      </div>
    </div>
  </div>
</section>