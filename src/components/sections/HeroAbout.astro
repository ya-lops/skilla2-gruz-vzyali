---
import Button from "@/components/ui/Button.astro";

interface Props {
  brandData: any;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section class="hero grid grid-cols-[100%] lg:min-h-[500px] bg-hero-main-surface" data-cmp="HeroMain">
  <div class="container h-full">
    <div class="grid grid-cols-1 lg:grid-cols-[4fr_2.5fr] gap-3 items-center h-full">
      <div class="flex flex-col gap-10 py-10 text-hero-main-text">
        <h1 class="flex flex-col items-start uppercase">
          <span class="max-md:w-min typo-h2-x2 bg-[#176ABD] rounded-2xl py-2 px-5 mb-2">100 000 заказов</span>
          <span class="typo-h2-x2">за 10 лет работы</span>
        </h1>

        <div class="mt-auto">
          <Button href={`/${firstServiceUrl}`} variant="accent" text="Наши услуги" />
        </div>
      </div>

      <div class="flex items-end justify-center self-end">
        <img src="/images/hero-about.webp" alt="" fetchpriority="high" class="pointer-events-none" />
      </div>
    </div>
  </div>
</section>