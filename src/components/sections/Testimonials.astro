---
import type { BrandData } from "@/types/brand";

import { STORAGE_PATH } from "@/lib/consts";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

{
  brandData.feedbacks.length > 0 && (
    <section class="py-8 md:py-10 lg:py-20" data-cmp="Testimonials">
      <div class="container">
        <h2 class="mb-8 md:12 lg:mb-16">Отзывы наших клиентов</h2>

        <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-6">
          {brandData.feedbacks?.map((testimonial: any) => (
            <div class="flex flex-col items-start gap-6 p-4 lg:p-10 border border-outline rounded-[1.25rem] text-text-secondary">
              <div class="flex items-start justify-center w-19 h-19 aspect-square mb-4 rounded-xl overflow-clip">
                {testimonial.avatar ? (
                  <img
                    class="w-full h-full object-cover object-top"
                    src={`${STORAGE_PATH}${testimonial.avatar}`}
                    alt={`Аватар ${testimonial.name} `}
                    loading="lazy"
                  />
                ) : (
                  <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
                    <path d="M0 0h32v32H0z" fill="none" />
                    <path
                      fill="none"
                      d="M8.007 24.93A4.996 4.996 0 0 1 13 20h6a4.996 4.996 0 0 1 4.993 4.93a11.94 11.94 0 0 1-15.986 0M20.5 12.5A4.5 4.5 0 1 1 16 8a4.5 4.5 0 0 1 4.5 4.5"
                    />
                    <path
                      fill="currentColor"
                      d="M26.749 24.93A13.99 13.99 0 1 0 2 16a13.9 13.9 0 0 0 3.251 8.93l-.02.017c.07.084.15.156.222.239c.09.103.187.2.28.3q.418.457.87.87q.14.124.28.242q.48.415.99.782c.044.03.084.069.128.1v-.012a13.9 13.9 0 0 0 16 0v.012c.044-.031.083-.07.128-.1q.51-.368.99-.782q.14-.119.28-.242q.451-.413.87-.87c.093-.1.189-.197.28-.3c.071-.083.152-.155.222-.24ZM16 8a4.5 4.5 0 1 1-4.5 4.5A4.5 4.5 0 0 1 16 8M8.007 24.93A4.996 4.996 0 0 1 13 20h6a4.996 4.996 0 0 1 4.993 4.93a11.94 11.94 0 0 1-15.986 0"
                    />
                  </svg>
                )}
              </div>

              <p class="typo-h4">{testimonial.name}</p>
              <p class="typo-t2">{testimonial.feedback}</p>

              {/* <p class="_testimonials-date text-text-tertiary typo-label">{testimonial.date ?? "12.03.2025"}</p> */}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
