---
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: any;
}

const { brandData } = Astro.props;

const features = [
  {
    icon: "24",
    text: "Круглосуточно<br>выполняем заказы",
    classes: "rotate-[13.16deg]",
  },
  {
    icon: "doc",
    text: "Работаем<br>по договору",
    classes: "rotate-[-1.72deg]",
  },
  {
    icon: "card",
    text: "Рассрочка при<br>крупных заказах",
    classes: "translate-x-[-17%] rotate-[12.67deg]",
  },
  {
    icon: "calendar",
    text: "15 лет<br>на рынке",
    classes: "translate-x-[-10%] rotate-[-2.13deg]",
  },
];
---

<section class="flex flex-col gap-1 items-end" data-cmp="HeroFeatures">
  {
    features.map((feature) => (
      <div class={`inline-flex items-center gap-3 py-4 px-3 pr-5 bg-surface-primary rounded-3xl ${feature.classes}`}>
        <div class=" shrink-0 text-accent">
          <IconSvg name={feature.icon} size={26} />
        </div>
        <div class="typo-t3">
          <Fragment set:html={feature.text} />
        </div>
      </div>
    ))
  }
</section>
