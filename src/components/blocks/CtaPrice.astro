---
import type { BrandData } from "@/types/brand";
import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";
import Button from "../ui/Button.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);
---

<section class="flex flex-col gap-10 p-6 lg:p-10 h-full text-cta-text" data-cmp="CtaPrice">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 h-full">
    <div class="flex flex-col h-full">
      <p class="">Стоимость наших сотрудников</p>
      <div class="_price mt-6 font-heading">
        <span class="uppercase">от</span>
        <span class="typo-h5-x2">
          {
            brandData.main?.adv_price && Number(brandData.main.adv_price) > 0
              ? brandData.main.adv_price
              : showDiscount
                ? discountedPrice
                : price
          }
        </span>
        <span class="uppercase">₽/час</span>
      </div>

      <div class="flex flex-col items-start gap-6 mt-auto pt-10 border-t border-t-outline/10">
        <p class="max-w-[20rem]">Свяжитесь с нами и мы расчитаем точную стоимость под ваши задачи</p>
        <Button class="shrink-0" href="#kp" variant="accent" text="Получить КП" />
      </div>
    </div>
    <div
      class="flex items-end lg:items-start justify-center"
    >
      <img src="/images/calc-result.webp" alt="" class="pointer-events-none" />
    </div>
  </div>
</section>
