---
import type { BrandData } from "@/types/brand";

import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: BrandData;
  class?: string;
}

const { brandData, class: className } = Astro.props;

const socials = brandData.main?.site_social_links;
---

{
  socials.length > 0 && (
    <div class:list={["flex items-center gap-2.75 *:rounded-lg *:overflow-clip *:hover:scale-105 *:transition-transform", className]} data-cmp="BlockSocialLinks">
      {socials?.map((link) => (
        <>
          {link.instagram && (
            <a href={link.instagram} target="_blank" rel="noopener noreferrer">
              <IconSvg name="instagram" />
            </a>
          )}
          {link.youtube && (
            <a href={link.youtube} target="_blank" rel="noopener noreferrer">
              <IconSvg name="youtube" />
            </a>
          )}
          {link.vk && (
            <a href={link.vk} target="_blank" rel="noopener noreferrer">
              <IconSvg name="vk-f" />
            </a>
          )}
          {link.rutube && (
            <a href={link.rutube} target="_blank" rel="noopener noreferrer">
              <IconSvg name="rutube" />
            </a>
          )}
          {link.dzen && (
            <a href={link.dzen} target="_blank" rel="noopener noreferrer">
              <IconSvg name="dzen" />
            </a>
          )}
        </>
      ))}
    </div>
  )
}
