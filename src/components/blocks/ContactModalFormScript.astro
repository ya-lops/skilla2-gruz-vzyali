<script is:inline>
  function contactModal() {
    return {
      open: false,
      submitting: false,
      form: {
        name: "",
        phone: "",
        agree: false,
      },
      errors: {},

      openModal() {
        this.open = true;
        this.errors = {};
        this.form = { name: "", phone: "", agree: false };
      },

      close() {
        this.open = false;
      },

      validate() {
        this.errors = {};
        if (!this.form.name.trim()) this.errors.name = true;
        if (!this.form.phone.trim()) this.errors.phone = true;
        if (!this.form.agree) this.errors.agree = true;
        return Object.keys(this.errors).length === 0;
      },

      async submitForm() {
        if (!this.validate()) return;

        this.submitting = true;

        try {
          const response = await fetch("https://api2.skilla.ru/api/site/call-me", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              phone: this.form.phone.replace(/\D/g, ""),
            }),
          });

          if (!response.ok) {
            throw new Error(`Ошибка сервера: ${response.status}`);
          }

          this.close();

          window.dispatchEvent(
            new CustomEvent("show-toast", {
              detail: {
                message: "Заявка отправлена! Мы скоро свяжемся с вами.",
                type: "success",
              },
            }),
          );
        } catch (error) {
          console.error("Ошибка отправки формы:", error);

          window.dispatchEvent(
            new CustomEvent("show-toast", {
              detail: {
                message: "Ошибка отправки. Попробуйте ещё раз.",
                type: "error",
              },
            }),
          );
        } finally {
          this.submitting = false;
        }
      },
    };
  }
</script>
