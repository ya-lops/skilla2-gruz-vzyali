---
import type { BrandData } from "@/types/brand";

import CtaPrice from "./CtaPrice.astro";

interface Props {
  brandData: BrandData;
}
const { brandData } = Astro.props;
---

<div class="relative h-full rounded-[20px] lg:rounded-[40px] isolate" data-cmp="CalculatorFormResultOurs">
  <div class="absolute -z-1 inset-0 bg-cta-surface rounded-[20px] lg:rounded-[40px]"></div>
  <CtaPrice {brandData} />
</div>
