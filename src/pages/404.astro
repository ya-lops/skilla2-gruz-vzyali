---
import BaseLayout from "@/layouts/BaseLayout.astro";

import { getBrandData } from "@/lib/api";
import Button from "@/components/ui/Button.astro";

const brandData = await getBrandData();
---

<BaseLayout brandData={brandData}>
  <section class="py-40">
    <div class="container">
      <div class="_404 flex flex-col items-center">
        <span class="text-[clamp(200px,20vw,516px)] text-text-primary font-heading font-semibold leading-[100%]">404</span>
        <p class="typo-t1 text-center">Такой страницы не существует</p>
        <Button href="/" variant="accent" class="mt-7" text="На главную" />
      </div>
    </div>
  </section>
</BaseLayout>
